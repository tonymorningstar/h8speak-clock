<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

<title>h8speak clock</title>

<style>
* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    width: min(92vw, 700px);
    text-align: center;
}

/* =========================================
   TITLE
   ========================================= */

.title {
    font-size: clamp(18px, 4vw, 28px);
    font-weight: 600;
    letter-spacing: 5px;
    margin-bottom: 20px;
    opacity: 0.75;
}

/* =========================================
   DIGITAL CLOCK
   ========================================= */

.digital {
    font-size: clamp(65px, 15vw, 130px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 2px;
    font-variant-numeric: tabular-nums;
    margin-bottom: 35px;
}

/* =========================================
   SOUND BUTTON
   ========================================= */

#soundButton {
    border: 1px solid #444;
    border-radius: 30px;

    background: #111;
    color: #fff;

    padding: 11px 22px;

    font-size: 14px;
    font-weight: 500;

    margin-bottom: 15px;

    cursor: pointer;

    -webkit-tap-highlight-color: transparent;
}

#soundButton:active {
    transform: scale(0.96);
}

/* =========================================
   CLOCK
   БЕЗ ВНЕШНЕГО КРУГА
   ========================================= */

.clock {
    position: relative;

    width: min(82vw, 500px);
    height: min(82vw, 500px);

    margin: auto;
}

/* =========================================
   NUMBERS 00–29
   ========================================= */

.number {
    position: absolute;

    width: 44px;
    height: 30px;

    text-align: center;

    font-size: clamp(12px, 3vw, 19px);

    line-height: 30px;

    font-variant-numeric: tabular-nums;

    transform: translate(-50%, -50%);
}

/* =========================================
   HANDS
   ========================================= */

.hand {
    position: absolute;

    left: 50%;
    bottom: 50%;

    transform-origin: 50% 100%;

    border-radius: 10px;

    transform:
        translateX(-50%)
        rotate(0deg);
}

/* Hour hand */

.hour-hand {
    width: 9px;
    height: 28%;

    background: #fff;

    z-index: 5;
}

/* Minute hand */

.minute-hand {
    width: 5px;
    height: 37%;

    background: #aaa;

    z-index: 6;
}

/* Second hand */

.second-hand {
    width: 2px;
    height: 42%;

    background: #666;

    z-index: 7;
}

/* =========================================
   CENTER
   ========================================= */

.center {
    position: absolute;

    width: 14px;
    height: 14px;

    background: #fff;

    border-radius: 50%;

    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);

    z-index: 10;
}

/* =========================================
   SMALL SCREENS
   ========================================= */

@media (max-height: 700px) {

    .title {
        margin-bottom: 10px;
    }

    .digital {
        margin-bottom: 20px;
    }

    .clock {
        width: min(60vh, 400px);
        height: min(60vh, 400px);
    }
}

</style>
</head>


<body>

<div class="container">

    <!-- TITLE -->

    <div class="title">
        h8speak clock
    </div>


    <!-- DIGITAL 30-HOUR TIME -->

    <div
        class="digital"
        id="digital"
    >
        00:00:00
    </div>


    <!-- SOUND BUTTON -->

    <button id="soundButton">
        🔊 START TICK
    </button>


    <!-- ANALOG CLOCK -->

    <div
        class="clock"
        id="clock"
    >

        <!--
            30 numbers (00–29)
            are generated by JavaScript
        -->


        <!-- HOUR HAND -->

        <div
            class="hand hour-hand"
            id="hourHand"
        ></div>


        <!-- MINUTE HAND -->

        <div
            class="hand minute-hand"
            id="minuteHand"
        ></div>


        <!-- SECOND HAND -->

        <div
            class="hand second-hand"
            id="secondHand"
        ></div>


        <!-- CENTER -->

        <div class="center"></div>

    </div>

</div>


<script>

/* =========================================================
   H8SPEAK CLOCK
   =========================================================

   REAL DAY:
       24 hours
       1440 minutes
       86400 seconds

   H8SPEAK DAY:
       30 hours
       1800 minutes
       108000 seconds

   24 real hours = 30 h8speak hours

   Therefore:

       30 / 24 = 1.25

   Every real second =
       1.25 h8speak seconds

   ========================================================= */


/* =========================================================
   GET CLOCK
   ========================================================= */

const clock =
    document.getElementById("clock");


/* =========================================================
   CREATE 30 NUMBERS
   =========================================================

   00 is at the top.

   Then:

   01
   02
   03
   ...
   29

   30 positions around the clock.
   ========================================================= */

for (let i = 0; i < 30; i++) {

    const number =
        document.createElement("div");

    number.className = "number";

    number.textContent =
        String(i).padStart(2, "0");


    /*
        Calculate angle.

        30 positions = 360 degrees.

        Therefore:

        1 number = 12 degrees.
    */

    const angle =
        (i / 30) * 360;

    const rad =
        angle * Math.PI / 180;


    /*
        Distance from center.
    */

    const radius = 43;


    /*
        Calculate position.
    */

    const x =
        50 + Math.sin(rad) * radius;

    const y =
        50 - Math.cos(rad) * radius;


    number.style.left =
        x + "%";

    number.style.top =
        y + "%";


    clock.appendChild(number);
}


/* =========================================================
   AUDIO
   ========================================================= */

let audioContext = null;

let soundEnabled = false;

let lastTickSecond = -1;


/*
    Sound button
*/

const soundButton =
    document.getElementById("soundButton");


/* =========================================================
   CREATE TICK SOUND
   ========================================================= */

function playTick() {

    if (
        !audioContext ||
        !soundEnabled
    ) {
        return;
    }


    /*
        Create oscillator.
    */

    const oscillator =
        audioContext.createOscillator();


    /*
        Create volume controller.
    */

    const gain =
        audioContext.createGain();


    /*
        Mechanical-like short sound.
    */

    oscillator.type =
        "square";


    /*
        Starting frequency.
    */

    oscillator.frequency.setValueAtTime(
        1800,
        audioContext.currentTime
    );


    /*
        Quickly lower frequency.
        This makes the sound more like
        a little mechanical click.
    */

    oscillator.frequency.exponentialRampToValueAtTime(
        700,
        audioContext.currentTime + 0.025
    );


    /*
        Start almost silent.
    */

    gain.gain.setValueAtTime(
        0.0001,
        audioContext.currentTime
    );


    /*
        Very fast attack.
    */

    gain.gain.exponentialRampToValueAtTime(
        0.12,
        audioContext.currentTime + 0.002
    );


    /*
        Very fast fade.
    */

    gain.gain.exponentialRampToValueAtTime(
        0.0001,
        audioContext.currentTime + 0.045
    );


    /*
        Connect everything.
    */

    oscillator.connect(gain);

    gain.connect(
        audioContext.destination
    );


    /*
        Start and stop.
    */

    oscillator.start();

    oscillator.stop(
        audioContext.currentTime + 0.05
    );
}


/* =========================================================
   START SOUND
   =========================================================

   iPhone/Safari requires a user interaction
   before audio can start.

   Therefore the user presses the button once.
   ========================================================= */

soundButton.addEventListener(
    "click",
    async function () {

        /*
            Create AudioContext.
        */

        if (!audioContext) {

            audioContext =
                new (
                    window.AudioContext ||
                    window.webkitAudioContext
                )();
        }


        /*
            Resume if Safari suspended it.
        */

        if (
            audioContext.state ===
            "suspended"
        ) {

            await audioContext.resume();
        }


        /*
            Enable ticking.
        */

        soundEnabled = true;


        /*
            Change button text.
        */

        soundButton.textContent =
            "🔊 TICK ON";


        /*
            Play immediate test tick.
        */

        playTick();
    }
);


/* =========================================================
   MAIN CLOCK FUNCTION
   ========================================================= */

function updateClock() {

    const now =
        new Date();


    /* =========================================
       REAL TIME
       ========================================= */

    const realHours =
        now.getHours();

    const realMinutes =
        now.getMinutes();

    const realSeconds =
        now.getSeconds();

    const milliseconds =
        now.getMilliseconds();


    /*
        Total real seconds
        since midnight.
    */

    const realTotalSeconds =

        realHours * 3600 +

        realMinutes * 60 +

        realSeconds +

        milliseconds / 1000;


    /* =========================================
       CONVERT TO H8SPEAK TIME
       =========================================

       24 hours -> 30 hours

       multiplier = 1.25
       ========================================= */

    const h8TotalSeconds =
        realTotalSeconds * 1.25;


    /* =========================================
       HOURS
       ========================================= */

    const h8Hours =
        Math.floor(
            h8TotalSeconds / 3600
        );


    /*
        Remaining seconds after hours.
    */

    const remaining =
        h8TotalSeconds % 3600;


    /* =========================================
       MINUTES
       ========================================= */

    const h8Minutes =
        Math.floor(
            remaining / 60
        );


    /* =========================================
       SECONDS
       ========================================= */

    const h8Seconds =
        Math.floor(
            remaining % 60
        );


    /* =========================================
       DIGITAL DISPLAY
       ========================================= */

    const h =
        String(h8Hours)
            .padStart(2, "0");


    const m =
        String(h8Minutes)
            .padStart(2, "0");


    const s =
        String(h8Seconds)
            .padStart(2, "0");


    document
        .getElementById("digital")
        .textContent =
        `${h}:${m}:${s}`;


    /* =========================================
       TICK SOUND
       =========================================

       The sound happens every new
       h8speak second.

       Since h8speak runs 1.25x faster,
       one tick occurs every 0.8 real seconds.
       ========================================= */

    if (
        soundEnabled &&
        h8Seconds !== lastTickSecond
    ) {

        playTick();

        lastTickSecond =
            h8Seconds;
    }


    /* =========================================
       HOUR HAND
       =========================================

       Full rotation:

       30 h8speak hours = 360 degrees
       ========================================= */

    const hourAngle =

        (
            h8TotalSeconds /
            (30 * 3600)
        ) * 360;


    /* =========================================
       MINUTE HAND
       =========================================

       Full rotation:

       60 minutes = 360 degrees
       ========================================= */

    const minuteAngle =

        (
            h8TotalSeconds /
            3600
        ) * 360;


    /* =========================================
       SECOND HAND
       =========================================

       Full rotation:

       60 seconds = 360 degrees
       ========================================= */

    const secondAngle =

        (
            h8TotalSeconds /
            60
        ) * 360;


    /* =========================================
       APPLY HAND ROTATION
       ========================================= */

    document
        .getElementById("hourHand")
        .style.transform =
        `translateX(-50%) rotate(${hourAngle}deg)`;


    document
        .getElementById("minuteHand")
        .style.transform =
        `translateX(-50%) rotate(${minuteAngle}deg)`;


    document
        .getElementById("secondHand")
        .style.transform =
        `translateX(-50%) rotate(${secondAngle}deg)`;
}


/* =========================================================
   RUN CLOCK
   =========================================================

   50ms update interval = 20 updates per second.

   This keeps the hands smooth.
   ========================================================= */

setInterval(
    updateClock,
    50
);


/*
    Initial update.
*/

updateClock();

</script>

</body>
</html>
